PORT=8080

# Postmark (contact + waitlist form notifications). Omit to disable; submissions
# are still stored in the database either way.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=noreply@helenalaundry.com
POSTMARK_TO=chante@helenalaundry.com

# Tracking (omit to disable)
GTAG_ID=
PIXEL_ID=

# Cloudflare Turnstile (omit to disable)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The pickup service area, pricing, and business identity are now edited in the
# admin dashboard (Settings) and stored in the database — no env vars needed.

# Search engines: set to true on a testing/staging deploy to keep the site out
# of search results (robots.txt Disallow, noindex meta, and X-Robots-Tag header).
# Leave unset/false in production so the site can be indexed.
SITE_NOINDEX=false

# Database
DB_PATH=./data/app.db

# Session
SESSION_SECRET=changeme
