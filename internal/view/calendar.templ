package view

import (
	"fmt"

	"github.com/firefly-software-mt/advanced-template/internal/store"

	"github.com/flintcraftstudio/flint-ui/components/button"
	"github.com/flintcraftstudio/flint-ui/components/input"
	"github.com/flintcraftstudio/flint-ui/components/selectbox"
	"github.com/flintcraftstudio/flint-ui/components/textarea"
)

// AdminCalendarPage is the full pickup-calendar page.
templ AdminCalendarPage(userEmail string, cal CalMonth) {
	@AdminBase("Calendar", userEmail, "calendar", calendarBody(cal))
}

templ calendarBody(cal CalMonth) {
	<p class="mb-6 text-sm text-muted-foreground">Place new pickups on a day, then move them through the week.</p>
	@CalendarRegion(cal)
}

// CalendarRegion is the htmx swap target — month nav, the unscheduled strip, the
// grid, and the phone agenda all re-render together. Editing happens in the
// shared admin drawer (see CalendarPickupPanel), which lives outside this region.
templ CalendarRegion(cal CalMonth) {
	<div id="calendar-region">
		@calToolbar(cal)
		@calUnscheduled(cal.Unscheduled, cal.Month)
		@calLegend()
		<!-- Month grid: tablet/desktop only — a 7-col grid is unreadable on a phone. -->
		<div class="hidden overflow-hidden rounded-2xl border border-border shadow-hl-sm sm:block">
			<div class="grid grid-cols-7 gap-px bg-border">
				for _, wd := range WeekdayLabels {
					<div class="bg-surface px-2 py-2 text-center text-[11px] font-semibold uppercase tracking-caps text-muted-foreground">{ wd }</div>
				}
				for _, week := range cal.Weeks {
					for _, d := range week {
						@calDayCell(d, cal.Month)
					}
				}
			</div>
		</div>
		<!-- Agenda: phone view — the same month as a day-grouped list. -->
		@calAgenda(cal)
	</div>
}

templ calToolbar(cal CalMonth) {
	<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
		<h2 class="font-display text-2xl text-foreground">{ cal.Label }</h2>
		<div class="flex items-center gap-2">
			@calNavButton("/admin/calendar?m="+cal.Prev, "Previous month") {
				@iconArrowRight("h-4 w-4 rotate-180")
			}
			if !cal.IsCurrent {
				@button.Button(button.Props{Outline: true, Attrs: calNavAttrs("/admin/calendar")}) { Today }
			}
			@calNavButton("/admin/calendar?m="+cal.Next, "Next month") {
				@iconArrowRight("h-4 w-4")
			}
		</div>
	</div>
}

// calNavButton is an icon-only month stepper.
templ calNavButton(href, label string) {
	<button
		type="button"
		aria-label={ label }
		class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border text-foreground transition hover:bg-muted"
		hx-get={ href }
		hx-target="#calendar-region"
		hx-swap="outerHTML"
		hx-push-url="true"
	>
		{ children... }
	</button>
}

// calUnscheduled is the "needs a date" strip of bookings with no scheduled day.
templ calUnscheduled(items []store.Booking, month string) {
	if len(items) > 0 {
		<div class="mb-4 rounded-2xl border border-warning/50 bg-warning/10 p-4">
			<div class="mb-2.5 flex items-center gap-2 text-sm font-semibold text-foreground">
				@iconClock("h-[18px] w-[18px] text-warning")
				Needs a date ({ fmt.Sprintf("%d", len(items)) })
			</div>
			<div class="flex flex-wrap gap-2">
				for _, b := range items {
					<button
						type="button"
						class="inline-flex items-center gap-1.5 rounded-pill border border-border bg-surface px-3 py-1.5 text-sm text-foreground transition hover:border-accent/50 hover:bg-muted"
						hx-get={ pickupURL(b.ID, month) }
						hx-target="#admin-drawer-body"
						hx-swap="innerHTML"
					>
						<span class="font-medium">{ b.Name }</span>
						<span class="text-muted-foreground">· { planShort(b.Plan) }</span>
					</button>
				}
			</div>
		</div>
	}
}

// calLegend is the key for the status dots used on the grid chips — without it
// the colors are recognition-by-memory. Hidden from screen readers because each
// chip already carries its status as sr-only text.
templ calLegend() {
	<div class="mb-3 hidden flex-wrap items-center gap-x-3.5 gap-y-1.5 text-[11px] text-muted-foreground sm:flex" aria-hidden="true">
		<span class="font-semibold uppercase tracking-caps text-muted-foreground/80">Status</span>
		for _, s := range bookingStatusOrder {
			<span class="inline-flex items-center gap-1.5">
				<span class={ bookingDotClass(s) }></span>
				{ bookingStatusLabel(s) }
			</span>
		}
	</div>
}

// calAgenda is the phone view (below sm): the month's scheduled pickups as a
// day-grouped list with full names, windows, and status text — the 7-col grid
// crushes those to an undecodable dot on a narrow screen. Same tap-to-edit
// behavior as the grid chips (loads the pickup panel).
templ calAgenda(cal CalMonth) {
	<div class="sm:hidden">
		if calHasScheduled(cal) {
			<ol class="space-y-5">
				for _, week := range cal.Weeks {
					for _, d := range week {
						if d.InMonth && len(d.Bookings) > 0 {
							@calAgendaDay(d, cal.Month)
						}
					}
				}
			</ol>
		} else {
			<p class="rounded-2xl border border-border bg-surface px-4 py-7 text-center text-sm text-muted-foreground shadow-hl-sm">
				Nothing scheduled this month yet.
			</p>
		}
	</div>
}

templ calAgendaDay(d CalDay, month string) {
	<li>
		<div class="mb-2 flex items-baseline gap-2">
			<h3 class={ "font-display text-lg", templ.KV("text-accent", d.IsToday), templ.KV("text-foreground", !d.IsToday) }>{ agendaDayLabel(d) }</h3>
			if d.IsToday {
				<span class="rounded-pill bg-accent/10 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-caps text-accent">Today</span>
			}
		</div>
		<div class="space-y-2">
			for _, b := range d.Bookings {
				@calAgendaRow(b, month)
			}
		</div>
	</li>
}

templ calAgendaRow(b store.Booking, month string) {
	<button
		type="button"
		class="flex w-full items-center gap-3 rounded-xl border border-border bg-surface px-3.5 py-3 text-left shadow-hl-sm transition hover:border-accent/40 hover:bg-muted/40"
		hx-get={ pickupURL(b.ID, month) }
		hx-target="#admin-drawer-body"
		hx-swap="innerHTML"
	>
		<span class={ bookingDotClass(b.Status) }></span>
		<span class="min-w-0 flex-1">
			<span class="block truncate font-medium text-foreground">{ b.Name }</span>
			<span class="block truncate text-xs text-muted-foreground">{ agendaMeta(b) }</span>
		</span>
		<span class="shrink-0 text-xs font-medium text-muted-foreground">{ bookingStatusLabel(b.Status) }</span>
	</button>
}

templ calDayCell(d CalDay, month string) {
	<div class={ "flex min-h-[104px] flex-col gap-1 p-1.5", templ.KV("bg-surface", d.InMonth), templ.KV("bg-muted/40", !d.InMonth) }>
		<div class="flex justify-end">
			<span class={ "inline-flex h-6 min-w-6 items-center justify-center rounded-full px-1 text-xs",
				templ.KV("text-muted-foreground/70", !d.InMonth),
				templ.KV("text-foreground", d.InMonth && !d.IsToday),
				templ.KV("bg-accent font-semibold text-accent-foreground", d.IsToday) }>
				{ fmt.Sprintf("%d", d.Day) }
			</span>
		</div>
		<div class="space-y-1">
			for _, b := range d.Bookings {
				@calChip(b, month)
			}
		</div>
	</div>
}

templ calChip(b store.Booking, month string) {
	<button
		type="button"
		class="flex w-full items-center gap-1.5 rounded-md bg-muted/70 px-1.5 py-1 text-left text-xs text-foreground transition hover:bg-muted"
		title={ b.Name + " — " + bookingStatusLabel(b.Status) }
		hx-get={ pickupURL(b.ID, month) }
		hx-target="#admin-drawer-body"
		hx-swap="innerHTML"
	>
		<span class={ bookingDotClass(b.Status) }></span>
		<span class="truncate">{ b.Name }</span>
		<span class="sr-only">— { bookingStatusLabel(b.Status) }</span>
	</button>
}

// CalendarPickupPanel is the slide-over drawer body for rescheduling one pickup
// from the calendar — the same drawer used by Pickups and Inquiries. Mirrors
// BookingEditPanel, but Save re-renders the whole #calendar-region (so the chip
// moves to its new day) and the handler fires admin-drawer-close to slide the
// panel shut. month is round-tripped so the rebuilt region stays on view.
templ CalendarPickupPanel(b store.Booking, month string) {
	@adminPanelShell("Edit pickup") {
		<form
			x-data={ "{ status: '" + b.Status + "' }" }
			hx-post={ fmt.Sprintf("/admin/calendar/pickup/%d", b.ID) }
			hx-target="#calendar-region"
			hx-swap="outerHTML"
			hx-disabled-elt="find button[type='submit']"
			class="flex flex-1 flex-col gap-5 overflow-y-auto px-6 py-5"
		>
			<input type="hidden" name="m" value={ month }/>
			<div class="space-y-1.5 text-sm">
				<h3 class="font-display text-base text-foreground">{ b.Name }</h3>
				@adminDetail("Address", orDash(b.Address)+", "+orDash(b.Zip))
				@adminDetail("Contact", b.Contact)
				@adminDetail("Plan", planShort(b.Plan))
				@adminDetail("Requested day", b.PickupDay)
				@adminDetail("Their note", orDash(b.Notes))
			</div>
			<div class="grid grid-cols-2 gap-3">
				<label class="block">
					<span class="mb-1.5 block text-sm font-medium text-foreground">Status</span>
					@selectbox.Select(selectbox.Props{Name: "status", Attrs: templ.Attributes{"x-model": "status", "data-autofocus": "true"}}) {
						for _, s := range bookingStatusOrder {
							<option value={ s } selected?={ s == b.Status }>{ bookingStatusLabel(s) }</option>
						}
					}
				</label>
				<label class="block">
					<span class="mb-1.5 block text-sm font-medium text-foreground">Pickup date</span>
					@input.Input(input.Props{Type: "date", Name: "scheduled_date", Value: b.ScheduledDate})
				</label>
			</div>
			<label class="block">
				<span class="mb-1.5 block text-sm font-medium text-foreground">Window</span>
				@input.Input(input.Props{Name: "pickup_window", Value: b.PickupWindow, Placeholder: "e.g. 9–11am"})
			</label>
			<label class="block">
				<span class="mb-1.5 block text-sm font-medium text-foreground">Private notes</span>
				@textarea.Textarea(textarea.Props{Name: "admin_notes", Rows: 3, Value: b.AdminNotes, NonResizable: true})
			</label>
			<p class="text-xs text-muted-foreground">Clear the date to send it back to “needs a date.”</p>
			@adminEditActions(templ.Attributes{
				"x-bind:hx-confirm": "status === 'canceled' ? 'Cancel this pickup? It drops off the calendar and the needs-a-date list.' : null",
			})
		</form>
	}
}

// calNavAttrs are the htmx attributes for a month-navigation control.
func calNavAttrs(href string) templ.Attributes {
	return templ.Attributes{
		"hx-get":      href,
		"hx-target":   "#calendar-region",
		"hx-swap":     "outerHTML",
		"hx-push-url": "true",
	}
}

// pickupURL is the GET that loads a pickup's edit panel for the given month.
func pickupURL(id int64, month string) string {
	return fmt.Sprintf("/admin/calendar/pickup/%d?m=%s", id, month)
}
