package view

templ NotFoundPage() {
	@Base(
		"Page not found",
		"This page came out in the wash. Head back home and let's get your laundry sorted instead.",
		notFoundContent(),
	)
}

templ notFoundContent() {
	<section class="bg-hl-cream">
		<div class="mx-auto flex max-w-content flex-col items-center px-5 py-28 text-center sm:px-8 sm:py-36">
			<picture>
				<source srcset="/static/img/badge-sm.webp" type="image/webp"/>
				<img src="/static/img/badge-sm.png" alt="" width="72" height="72" class="h-18 w-18 rounded-full opacity-90"/>
			</picture>
			<p class="eyebrow mt-6">404</p>
			<h1 class="mt-3 max-w-xl font-display text-[clamp(2.2rem,5vw,3.4rem)] leading-[1.06] text-hl-brown">Well, this page came out in the wash.</h1>
			<p class="mt-5 max-w-md text-[18px] leading-relaxed text-hl-brown-soft">
				Nothing here. Head back home and let's get your laundry sorted instead.
			</p>
			<div class="mt-9 flex flex-wrap justify-center gap-3.5">
				@btnGhost("/", "Back to home")
				@btnCall("Call or text to schedule")
			</div>
		</div>
	</section>
}
