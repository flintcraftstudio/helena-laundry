package view

templ ServicesPage() {
	@Base(
		"Services & pricing",
		"Wash, dry, fold & hang at $2/lb. Rush service $3/lb. Flat rates on bedding, sneakers, and bulk towels. No packages to decode, no surprise fees — here's all of it, plain.",
		servicesContent(),
	)
}

templ servicesContent() {
	<!-- Header -->
	<section class="bg-hl-cream">
		<div class="mx-auto max-w-content px-5 pt-16 pb-10 sm:px-8 sm:pt-20">
			<div class="max-w-2xl">
				@eyebrow("Services & pricing")
				<h1 class="font-display text-[clamp(2.4rem,5vw,3.6rem)] leading-[1.05] text-hl-brown">What I do, and what it costs.</h1>
				<p class="mt-5 text-[19px] leading-relaxed text-hl-brown-soft">No packages to decode, no surprise fees. Here's all of it, plain.</p>
			</div>
			<div class="mt-8">
				@doubleRule()
			</div>
		</div>
	</section>

	<!-- Core services -->
	<section id="pricing" class="bg-hl-cream scroll-mt-24">
		<div class="mx-auto max-w-content px-5 pb-8 sm:px-8">
			<div class="grid gap-6 lg:grid-cols-2">
				<!-- Everyday -->
				<div class="rounded-2xl border border-hl-rust/25 bg-hl-white p-8 shadow-hl-sm">
					<div class="flex items-start justify-between gap-4">
						<div>
							@tag("Everyday service", "ochre")
							<h2 class="mt-4 font-display text-[28px] leading-tight text-hl-brown">Wash, dry, fold &amp; hang</h2>
						</div>
						<p class="shrink-0 font-display text-[40px] leading-none text-hl-rust">$2<span class="text-[18px] text-hl-brown-faint">/lb</span></p>
					</div>
					<p class="mt-5 text-[16px] leading-relaxed text-hl-brown-soft">
						The everyday service. You bag it up, I pick it up, and it comes back clean, dry, folded, and hung where hanging matters. I sort it myself — whites, colors, the delicate stuff — and your laundry gets its own load. It never goes in with anyone else's.
					</p>
					<p class="mt-4 text-[16px] leading-relaxed text-hl-brown-soft">
						For reference, a stuffed 13-gallon trash bag runs about $30. I won't know your exact number until it's on the scale, and I'll tell you the moment I do.
					</p>
					<div class="mt-6 flex items-center gap-3 rounded-xl bg-hl-cream-deep px-5 py-3.5 text-[15px]">
						@iconCheck("h-5 w-5 shrink-0 text-hl-teal")
						<span><span class="font-semibold text-hl-brown">Minimum order is $35</span> — about one full trash bag.</span>
					</div>
				</div>
				<!-- Rush -->
				<div class="rounded-2xl border border-hl-brown/10 bg-hl-white p-8 shadow-hl-sm">
					<div class="flex items-start justify-between gap-4">
						<div>
							@tag("Need it fast", "rust")
							<h2 class="mt-4 font-display text-[28px] leading-tight text-hl-brown">Rush service</h2>
						</div>
						<p class="shrink-0 font-display text-[40px] leading-none text-hl-rust">$3<span class="text-[18px] text-hl-brown-faint">/lb</span></p>
					</div>
					<p class="mt-5 text-[16px] leading-relaxed text-hl-brown-soft">
						Need it back in 24 hours or less? I'll make it happen. Same care, faster turnaround.
					</p>
					<div class="mt-6 flex items-center gap-3 rounded-xl bg-hl-cream-deep px-5 py-3.5 text-[15px]">
						@iconClock("h-5 w-5 shrink-0 text-hl-teal")
						<span><span class="font-semibold text-hl-brown">Back in 24 hours</span> or less.</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- The bulky stuff -->
	<section class="bg-hl-cream">
		<div class="mx-auto max-w-content px-5 py-12 sm:px-8">
			<div class="rounded-2xl border border-hl-brown/10 bg-hl-tint p-8 shadow-hl-sm sm:p-10">
				<div class="max-w-2xl">
					@eyebrow("Flat rates")
					<h2 class="font-display text-[clamp(1.8rem,3.4vw,2.5rem)] leading-tight text-hl-brown">The bulky stuff</h2>
					<p class="mt-4 text-[16px] leading-relaxed text-hl-brown-soft">Some things don't make sense by the pound, so they've got their own price:</p>
				</div>
				<div class="mt-7 grid gap-x-10 gap-y-1 sm:grid-cols-2">
					@flatRate("Twin bedding", "$15")
					@flatRate("Full bedding", "$20")
					@flatRate("Queen bedding", "$30")
					@flatRate("King bedding", "$35")
					@flatRate("Sneaker deep clean (cleaning & stain treatment)", "$20")
					@flatRate("13-gallon bag of towels, rags, or similar", "$35")
				</div>
				<p class="mt-7 max-w-2xl text-[15px] leading-relaxed text-hl-brown-soft">
					Sheet-only orders still need to hit the $35 minimum — easy enough to do with a couple of sets, or by adding a regular load on top.
				</p>
			</div>
		</div>
	</section>

	<!-- Stain + turnaround + no dry cleaning + where I go -->
	<section class="bg-hl-cream">
		<div class="mx-auto max-w-content px-5 pb-16 sm:px-8">
			<div class="grid gap-6 md:grid-cols-2">
				@infoCard("Stain treatment", "I'll treat what I can, and the first five items are free. After that it's $5 for six to ten items, $10 for eleven to twenty. I'll never charge you for something I couldn't get out.") {
					@iconSparkle("h-6 w-6")
				}
				@infoCard("Turnaround", "Most orders are back on your porch in 24 to 48 hours. Rush orders, 24 or less.") {
					@iconClock("h-6 w-6")
				}
				@infoCard("Where I go", "The Helena Valley, for now. Outside it and want in? Put your name on the waitlist — I expand toward wherever the demand is.") {
					@iconMapPin("h-6 w-6")
				}
				@infoCard("One thing I don't do: dry cleaning.", "I'm wash-and-fold, start to finish. If you've got dry-clean-only pieces, you'll want a dedicated cleaner for those — everything else, bring it on.") {
					@iconWasher("h-6 w-6")
				}
			</div>
		</div>
	</section>

	<!-- Becoming a regular (teal band) -->
	<section class="bg-hl-teal-deep text-hl-cream">
		<div class="mx-auto max-w-content px-5 py-18 sm:px-8 sm:py-20">
			<div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
				<div class="max-w-2xl">
					<p class="text-[13px] font-bold uppercase tracking-caps text-hl-ochre">Becoming a regular</p>
					<h2 class="mt-4 font-display text-[clamp(1.9rem,3.6vw,2.75rem)] leading-tight text-hl-cream">Like how the first one goes? Let's set a standing day.</h2>
					<p class="mt-5 text-[17px] leading-relaxed text-hl-cream/85">
						Weekly or every other week. Same $2 a pound, and I'll bring you proper laundry bags so you can quit raiding the kitchen trash box. You can still schedule one-off pickups whenever, too.
					</p>
				</div>
				<div class="lg:pl-8">
					<a
						href={ templ.SafeURL(PhoneTel) }
						class="inline-flex items-center gap-2.5 rounded-pill bg-hl-cream px-7 py-3.5 text-[16px] font-semibold text-hl-teal-deep transition duration-200 ease-hl-out hover:bg-hl-white active:scale-[0.97]"
					>
						@iconPhone("h-[18px] w-[18px]")
						Call or text: { Phone }
					</a>
				</div>
			</div>
		</div>
	</section>
}

// ---- Services-only helpers ----

templ tag(label, tone string) {
	<span class={ "inline-flex items-center rounded-pill px-3.5 py-1.5 text-[12px] font-bold uppercase tracking-wide", templ.KV("bg-hl-ochre text-hl-brown", tone == "ochre"), templ.KV("bg-hl-rust/10 text-hl-rust", tone == "rust"), templ.KV("bg-hl-teal/15 text-hl-teal-deep", tone == "teal") }>
		{ label }
	</span>
}

templ flatRate(label, price string) {
	<div class="flex items-baseline justify-between gap-4 border-b border-dashed border-hl-brown/15 py-3">
		<span class="text-[16px] text-hl-brown">{ label }</span>
		<span class="shrink-0 font-display text-[22px] text-hl-rust">{ price }</span>
	</div>
}

templ infoCard(title, body string) {
	<div class="rounded-2xl border border-hl-brown/10 bg-hl-white p-7 shadow-hl-sm">
		<span class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-hl-teal/10 text-hl-teal-deep">
			{ children... }
		</span>
		<h3 class="font-display text-[22px] leading-snug text-hl-brown">{ title }</h3>
		<p class="mt-2.5 text-[15px] leading-relaxed text-hl-brown-soft">{ body }</p>
	</div>
}
