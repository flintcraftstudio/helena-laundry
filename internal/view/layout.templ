package view

templ Base(title, description string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="bg-hl-cream text-hl-brown">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content={ description }/>
			<title>{ title } | { SiteName }</title>
			<meta name="theme-color" content="#C0492B"/>
			<link rel="icon" type="image/png" href="/static/img/favicon.png"/>
			<link rel="apple-touch-icon" href="/static/img/favicon.png"/>
			<!-- Open Graph -->
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content={ SiteName }/>
			<meta property="og:title" content={ title + " | " + SiteName }/>
			<meta property="og:description" content={ description }/>
			<meta property="og:image" content="/static/img/badge.png"/>
			<meta name="twitter:card" content="summary"/>
			if GtagID != "" {
				<script async src={ "https://www.googletagmanager.com/gtag/js?id=" + GtagID }></script>
				@gtagInit()
			}
			if PixelID != "" {
				@pixelInit()
				<noscript><img height="1" width="1" style="display:none" src={ "https://www.facebook.com/tr?id=" + PixelID + "&ev=PageView&noscript=1" }/></noscript>
			}
			if TurnstileSiteKey != "" {
				<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
			}
			<link rel="stylesheet" href="/static/css/site.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/alpine.min.js" defer></script>
		</head>
		<body class="min-h-screen bg-hl-cream pb-[72px] font-body text-base font-normal leading-relaxed text-hl-brown antialiased lg:pb-0">
			<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-pill focus:bg-hl-rust focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-hl-white">Skip to content</a>
			@Nav()
			<main id="main">
				@body
			</main>
			@Footer()
			@MobileCallBar()
			@BookingModal()
			@formSwapScript()
		</body>
	</html>
}

// formSwapScript moves focus to a swapped-in [data-formstatus] region (error
// banner or success confirmation) after any htmx swap, so keyboard + screen-reader
// users land on what happened — and re-renders any Turnstile widget the swap
// brought in (Cloudflare's implicit render only runs on full page load). Lives in
// the layout so every htmx form (login, contact, future) gets it for free.
templ formSwapScript() {
	<script>
		(function () {
			document.body.addEventListener("htmx:afterSwap", function (e) {
				var scope = e.target;
				if (!scope || !scope.querySelector) return;
				var focusEl = scope.querySelector("[data-formstatus]") || scope.querySelector("[data-autofocus]");
				if (focusEl) focusEl.focus();
				if (window.turnstile) {
					scope.querySelectorAll(".cf-turnstile").forEach(function (n) {
						try { window.turnstile.render(n); } catch (err) {}
					});
				}
			});
		})();
	</script>
}

// MobileCallBar is a persistent thumb-zone call/text bar shown only on small
// screens, where the sticky desktop phone CTA is hidden. The primary action of
// the whole site — call or text — stays one tap away no matter how far you scroll.
templ MobileCallBar() {
	<div
		class="fixed inset-x-0 bottom-0 z-40 border-t border-hl-brown/10 bg-hl-cream/95 px-4 pt-3 backdrop-blur-md lg:hidden"
		style="padding-bottom:calc(0.75rem + env(safe-area-inset-bottom))"
	>
		<div class="mx-auto flex max-w-content gap-3">
			<a
				href={ templ.SafeURL(PhoneTel) }
				class="flex flex-1 items-center justify-center gap-2 rounded-pill bg-hl-rust px-5 py-3 text-base font-semibold text-hl-white shadow-[0_4px_14px_rgba(192,73,43,0.18)] active:scale-[0.98]"
			>
				@iconPhone("h-[18px] w-[18px]")
				Call
			</a>
			<a
				href={ templ.SafeURL(PhoneSMS) }
				class="flex flex-1 items-center justify-center gap-2 rounded-pill border-[1.5px] border-hl-rust-deep px-5 py-3 text-base font-semibold text-hl-rust-deep active:scale-[0.98]"
			>
				@iconMessage("h-[18px] w-[18px]")
				Text
			</a>
		</div>
	</div>
}

templ gtagInit() {
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', '{ GtagID }');
	</script>
}

templ pixelInit() {
	<script>
		!function(f,b,e,v,n,t,s)
		{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
		n.callMethod.apply(n,arguments):n.queue.push(arguments)};
		if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
		n.queue=[];t=b.createElement(e);t.async=!0;
		t.src=v;s=b.getElementsByTagName(e)[0];
		s.parentNode.insertBefore(t,s)}(window, document,'script',
		'https://connect.facebook.net/en_US/fbevents.js');
		fbq('init', '{ PixelID }');
		fbq('track', 'PageView');
	</script>
}
