package view

templ LoginPage(errMsg, email string) {
	@Base("Sign in", "Sign in to the Helena Laundry admin.", loginContent(errMsg, email))
}

templ loginContent(errMsg, email string) {
	<section class="bg-hl-cream">
		<div class="mx-auto max-w-content px-5 py-24 sm:px-8 sm:py-28">
			<div class="mx-auto max-w-sm">
				@eyebrow("Admin")
				<h1 class="font-display text-[clamp(2rem,4vw,2.8rem)] leading-tight text-hl-brown">Sign in</h1>
				<div class="mt-8 rounded-2xl border border-hl-brown/10 bg-hl-white p-7 shadow-hl-sm">
					@LoginForm(errMsg, email)
				</div>
			</div>
		</div>
	</section>
}

templ LoginForm(errMsg, email string) {
	<form hx-post="/login" hx-swap="outerHTML" class="space-y-4">
		if errMsg != "" {
			@formError(errMsg)
		}
		<div>
			<label for="email" class="mb-1.5 block text-[14px] font-semibold text-hl-brown">Email</label>
			<input
				type="email"
				id="email"
				name="email"
				value={ email }
				class="hl-input"
				placeholder="you@example.com"
				autocomplete="username"
				autofocus
				required
			/>
		</div>
		<div>
			<label for="password" class="mb-1.5 block text-[14px] font-semibold text-hl-brown">Password</label>
			<div class="relative" x-data="{ show: false }">
				<input
					type="password"
					:type="show ? 'text' : 'password'"
					id="password"
					name="password"
					class="hl-input pr-12"
					placeholder="Enter your password"
					autocomplete="current-password"
					required
				/>
				<button
					type="button"
					@click="show = !show"
					:aria-label="show ? 'Hide password' : 'Show password'"
					:aria-pressed="show"
					class="absolute inset-y-0 right-0 flex items-center px-3.5 text-hl-brown-soft transition hover:text-hl-rust-deep"
				>
					<span x-show="!show">
						@iconEye("h-5 w-5")
					</span>
					<span x-show="show" x-cloak>
						@iconEyeOff("h-5 w-5")
					</span>
				</button>
			</div>
		</div>
		@submitButton("Sign in")
		<p class="text-center text-[13px] leading-relaxed text-hl-brown-soft">
			Locked out? Your sign-in is reset from the server — reach whoever set up the site.
		</p>
	</form>
}
