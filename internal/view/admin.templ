package view

import (
	"fmt"

	"github.com/firefly-software-mt/advanced-template/internal/store"

	"github.com/flintcraftstudio/flint-ui/components/badge"
	"github.com/flintcraftstudio/flint-ui/components/button"
	"github.com/flintcraftstudio/flint-ui/components/card"
	"github.com/flintcraftstudio/flint-ui/components/input"
	"github.com/flintcraftstudio/flint-ui/components/selectbox"
	"github.com/flintcraftstudio/flint-ui/components/table"
	"github.com/flintcraftstudio/flint-ui/components/tabs"
	"github.com/flintcraftstudio/flint-ui/components/textarea"
)

// ===========================================================================
// Dashboard
// ===========================================================================

templ AdminDashboardPage(userEmail string, counts AdminCounts, bookings []store.Booking, inquiries []store.Question, waitlist []store.WaitlistEntry) {
	@AdminBase("Dashboard", userEmail, "dashboard", adminDashboardBody(counts, bookings, inquiries, waitlist))
}

templ adminDashboardBody(counts AdminCounts, bookings []store.Booking, inquiries []store.Question, waitlist []store.WaitlistEntry) {
	<p class="mb-6 text-sm text-muted-foreground">What needs you today.</p>
	<div class="grid gap-4 sm:grid-cols-3">
		@countTile("/admin/bookings", "New pickups", counts.Bookings)
		@countTile("/admin/inquiries", "New inquiries", counts.Inquiries)
		@countTile("/admin/waitlist", "New on waitlist", counts.Waitlist)
	</div>
	<div class="mt-8 space-y-8">
		@recentCard("Latest pickups", "/admin/bookings") {
			if len(bookings) == 0 {
				@adminEmpty("No pickups yet.")
			} else {
				@table.Table(table.Props{Bleed: true}) {
					@table.Body(table.BodyProps{}) {
						for _, b := range bookings {
							@table.Row(table.RowProps{}) {
								@table.Cell(table.CellProps{Dense: true}) {
									<span class="font-medium text-foreground">{ b.Name }</span>
								}
								@table.Cell(table.CellProps{Dense: true}) {
									<span class="text-muted-foreground">{ planShort(b.Plan) } · { orDash(b.Zip) }</span>
								}
								@table.Cell(table.CellProps{Dense: true}) {
									@badge.Badge(badge.Props{Variant: bookingStatusVariant(b.Status)}) {
										{ bookingStatusLabel(b.Status) }
									}
								}
								@table.Cell(table.CellProps{Dense: true, Class: "text-right text-muted-foreground"}) {
									{ humanDate(b.CreatedAt) }
								}
							}
						}
					}
				}
			}
		}
		@recentCard("Latest inquiries", "/admin/inquiries") {
			if len(inquiries) == 0 {
				@adminEmpty("No inquiries yet.")
			} else {
				@table.Table(table.Props{Bleed: true}) {
					@table.Body(table.BodyProps{}) {
						for _, q := range inquiries {
							@table.Row(table.RowProps{}) {
								@table.Cell(table.CellProps{Dense: true}) {
									<span class="font-medium text-foreground">{ q.Name }</span>
								}
								@table.Cell(table.CellProps{Dense: true, Class: "text-muted-foreground"}) {
									{ truncate(q.Message, 48) }
								}
								@table.Cell(table.CellProps{Dense: true}) {
									@badge.Badge(badge.Props{Variant: questionStatusVariant(q.Status)}) {
										{ questionStatusLabel(q.Status) }
									}
								}
								@table.Cell(table.CellProps{Dense: true, Class: "text-right text-muted-foreground"}) {
									{ humanDate(q.CreatedAt) }
								}
							}
						}
					}
				}
			}
		}
	</div>
}

templ countTile(href, label string, n int) {
	<a href={ templ.SafeURL(href) } class="group block">
		@card.Card(card.Props{Class: "transition group-hover:border-accent/40"}) {
			@card.Body(card.SubProps{}) {
				<div class="flex items-center justify-between">
					<span class="text-sm font-medium text-muted-foreground">{ label }</span>
					if n > 0 {
						@badge.Badge(badge.Props{Variant: badge.VariantAccent}) { { fmt.Sprintf("%d", n) } }
					}
				</div>
				<div class="mt-2 font-display text-3xl text-foreground">{ fmt.Sprintf("%d", n) }</div>
			}
		}
	</a>
}

templ recentCard(title, href string) {
	@card.Card(card.Props{}) {
		@card.Header(card.SubProps{Class: "flex items-center justify-between"}) {
			<h2 class="font-display text-lg text-foreground">{ title }</h2>
			<a href={ templ.SafeURL(href) } class="text-sm font-medium text-accent hover:text-accent/80">View all</a>
		}
		@card.Body(card.SubProps{}) {
			{ children... }
		}
	}
}

// ===========================================================================
// Pickups
// ===========================================================================

templ AdminBookingsPage(userEmail string, bv BookingsView) {
	@AdminBase("Pickups", userEmail, "bookings", adminSectionIntro("Pickup bookings", "Schedule, track, and close out every pickup.", BookingsSection(bv)))
}

templ BookingsSection(bv BookingsView) {
	<section id="bookings-section">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
			@adminFilterTabs("bookings-section", "/admin/bookings", bv.Status, bookingStatusOrder, bookingStatusLabel, bookingsTabExtra(bv.Search), "#bookings-spinner")
			<div class="flex items-center gap-2">
				<span id="bookings-spinner" class="htmx-indicator text-muted-foreground">
					@iconSpinner("h-4 w-4 animate-spin")
				</span>
				@input.Input(input.Props{
					Type:         "search",
					Name:         "q",
					ID:           "bookings-search",
					Value:        bv.Search,
					Placeholder:  "Search name, contact, ZIP…",
					Autocomplete: "off",
					Class:        "sm:w-64",
					Attrs: templ.Attributes{
						"hx-get":       "/admin/bookings" + statusQuery(bv.Status),
						"hx-trigger":   "input changed delay:300ms, search",
						"hx-target":    "#bookings-section",
						"hx-swap":      "outerHTML",
						"hx-indicator": "#bookings-spinner",
						"hx-push-url":  "true",
						"hx-preserve":  "true",
						"aria-label":   "Search pickups",
					},
				})
			</div>
		</div>
		<div class="mt-4">
			@card.Card(card.Props{}) {
				@card.Body(card.SubProps{}) {
					if len(bv.Bookings) == 0 {
						@adminEmpty(bookingsEmptyMsg(bv))
					} else {
						@table.Table(table.Props{}) {
							@table.Head(table.HeadProps{}) {
								<tr>
									@table.Header(table.HeaderProps{}) { Customer }
									@table.Header(table.HeaderProps{Class: "hidden md:table-cell"}) { Contact }
									@table.Header(table.HeaderProps{Class: "hidden lg:table-cell"}) { Requested }
									@table.Header(table.HeaderProps{Class: "hidden lg:table-cell"}) { Plan }
									@table.Header(table.HeaderProps{}) { Scheduled }
									@table.Header(table.HeaderProps{}) { Status }
									@table.Header(table.HeaderProps{Class: "text-right"}) {
										<span class="sr-only">Edit</span>
									}
								</tr>
							}
							@table.Body(table.BodyProps{}) {
								for _, b := range bv.Bookings {
									@BookingSummaryRow(b)
								}
							}
						}
					}
				}
			}
		</div>
		@bookingsPager(bv)
	</section>
}

// bookingsPager shows the result range and Prev/Next paging (htmx, push-url).
templ bookingsPager(bv BookingsView) {
	if bv.Total > 0 {
		<div class="mt-4 flex items-center justify-between text-sm text-muted-foreground">
			<span>{ pagerLabel(bv) }</span>
			<div class="flex items-center gap-2">
				@pagerButton(bv, bv.Page-1, "Prev", bv.Page <= 1)
				@pagerButton(bv, bv.Page+1, "Next", !hasNextPage(bv))
			</div>
		</div>
	}
}

templ pagerButton(bv BookingsView, page int, label string, disabled bool) {
	if disabled {
		@button.Button(button.Props{Plain: true, Disabled: true}) {
			{ label }
		}
	} else {
		@button.Button(button.Props{Plain: true, Attrs: templ.Attributes{
			"hx-get":       bookingsURL(bv.Status, bv.Search, page),
			"hx-target":    "#bookings-section",
			"hx-swap":      "outerHTML",
			"hx-indicator": "#bookings-spinner",
			"hx-push-url":  "true",
		}}) {
			{ label }
		}
	}
}

templ BookingSummaryRow(b store.Booking) {
	@table.Row(table.RowProps{Class: rowClickClass, Attrs: rowEditAttrs("/admin/bookings", "booking", b.ID, "Edit pickup for "+b.Name)}) {
		@table.Cell(table.CellProps{}) {
			<div class="font-medium text-foreground">{ b.Name }</div>
			<div class="text-xs text-muted-foreground">{ orDash(b.Address) }, { orDash(b.Zip) }</div>
		}
		@table.Cell(table.CellProps{Class: "hidden text-muted-foreground md:table-cell"}) { { b.Contact } }
		@table.Cell(table.CellProps{Class: "hidden text-muted-foreground lg:table-cell"}) { { b.PickupDay } }
		@table.Cell(table.CellProps{Class: "hidden text-muted-foreground lg:table-cell"}) { { planShort(b.Plan) } }
		@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
			@scheduledCell(b)
		}
		@table.Cell(table.CellProps{}) {
			@badge.Badge(badge.Props{Variant: bookingStatusVariant(b.Status)}) { { bookingStatusLabel(b.Status) } }
		}
		@table.Cell(table.CellProps{Class: "text-right text-muted-foreground"}) {
			@iconChevronRight("inline h-4 w-4")
		}
	}
}

// scheduledCell shows the scheduled date/window plus a Today/Overdue pill for
// active bookings whose date is here or past — the operator's "what needs me".
templ scheduledCell(b store.Booking) {
	<div class="flex flex-col items-start gap-1">
		<span>{ scheduledLabel(b.ScheduledDate, b.PickupWindow) }</span>
		switch bookingTimeFlag(b) {
			case "today":
				@badge.Badge(badge.Props{Variant: badge.VariantAccent}) { Today }
			case "overdue":
				@badge.Badge(badge.Props{Variant: badge.VariantDanger}) { Overdue }
		}
	</div>
}

// BookingEditPanel is the slide-over drawer body for editing one pickup. Save
// targets the booking's table row (swaps in the refreshed summary) and the
// handler fires admin-drawer-close to slide the panel shut.
templ BookingEditPanel(b store.Booking) {
	@adminPanelShell("Edit pickup") {
		<form
			x-data={ "{ status: '" + b.Status + "' }" }
			hx-post={ fmt.Sprintf("/admin/bookings/%d", b.ID) }
			hx-target={ "#" + rowID("booking", b.ID) }
			hx-swap="outerHTML"
			hx-disabled-elt="find button[type='submit']"
			class="flex flex-1 flex-col gap-5 overflow-y-auto px-6 py-5"
		>
			<div class="space-y-1.5 text-sm">
				<h3 class="font-display text-base text-foreground">{ b.Name }</h3>
				@adminDetail("Address", orDash(b.Address)+", "+orDash(b.Zip))
				@adminDetail("Contact", b.Contact)
				@adminDetail("Plan", planShort(b.Plan))
				@adminDetail("Requested day", b.PickupDay)
				@adminDetail("Their note", orDash(b.Notes))
				@adminDetail("Booked", humanDateTime(b.CreatedAt))
			</div>
			<div class="grid grid-cols-2 gap-3">
				<label class="block">
					<span class="mb-1.5 block text-sm font-medium text-foreground">Status</span>
					@selectbox.Select(selectbox.Props{Name: "status", Attrs: templ.Attributes{"x-model": "status", "data-autofocus": "true"}}) {
						for _, s := range bookingStatusOrder {
							<option value={ s } selected?={ s == b.Status }>{ bookingStatusLabel(s) }</option>
						}
					}
				</label>
				<label class="block">
					<span class="mb-1.5 block text-sm font-medium text-foreground">Pickup date</span>
					@input.Input(input.Props{Type: "date", Name: "scheduled_date", Value: b.ScheduledDate})
				</label>
			</div>
			<label class="block">
				<span class="mb-1.5 block text-sm font-medium text-foreground">Window</span>
				@input.Input(input.Props{Name: "pickup_window", Value: b.PickupWindow, Placeholder: "e.g. 9–11am"})
			</label>
			<label class="block">
				<span class="mb-1.5 block text-sm font-medium text-foreground">Private notes</span>
				@textarea.Textarea(textarea.Props{Name: "admin_notes", Rows: 3, Value: b.AdminNotes, NonResizable: true})
			</label>
			@adminEditActions(templ.Attributes{
				"x-bind:hx-confirm": "status === 'canceled' ? 'Cancel this pickup? It drops off the calendar and the needs-a-date list.' : null",
			})
		</form>
	}
}

// ===========================================================================
// Inquiries
// ===========================================================================

templ AdminInquiriesPage(userEmail, status string, inquiries []store.Question) {
	@AdminBase("Inquiries", userEmail, "inquiries", adminSectionIntro("Contact inquiries", "Questions and feedback sent from the site.", InquiriesSection(status, inquiries)))
}

templ InquiriesSection(status string, inquiries []store.Question) {
	<section id="inquiries-section">
		@adminFilterTabs("inquiries-section", "/admin/inquiries", status, questionStatusOrder, questionStatusLabel, "", "")
		<div class="mt-4">
			@card.Card(card.Props{}) {
				@card.Body(card.SubProps{}) {
					if len(inquiries) == 0 {
						@adminEmpty("No inquiries here yet.")
					} else {
						@table.Table(table.Props{}) {
							@table.Head(table.HeadProps{}) {
								<tr>
									@table.Header(table.HeaderProps{}) { From }
									@table.Header(table.HeaderProps{}) { Topic }
									@table.Header(table.HeaderProps{}) { Message }
									@table.Header(table.HeaderProps{}) { Received }
									@table.Header(table.HeaderProps{}) { Status }
									@table.Header(table.HeaderProps{Class: "text-right"}) {
										<span class="sr-only">Edit</span>
									}
								</tr>
							}
							@table.Body(table.BodyProps{}) {
								for _, q := range inquiries {
									@InquirySummaryRow(q)
								}
							}
						}
					}
				}
			}
		</div>
	</section>
}

templ InquirySummaryRow(q store.Question) {
	@table.Row(table.RowProps{Class: rowClickClass, Attrs: rowEditAttrs("/admin/inquiries", "inquiry", q.ID, "Edit inquiry from "+q.Name)}) {
		@table.Cell(table.CellProps{}) {
			<div class="font-medium text-foreground">{ q.Name }</div>
			<div class="text-xs text-muted-foreground">{ q.Contact }</div>
		}
		@table.Cell(table.CellProps{Class: "text-muted-foreground"}) { { q.Topic } }
		@table.Cell(table.CellProps{Class: "max-w-xs truncate text-muted-foreground"}) { { truncate(q.Message, 60) } }
		@table.Cell(table.CellProps{Class: "text-muted-foreground"}) { { humanDate(q.CreatedAt) } }
		@table.Cell(table.CellProps{}) {
			@badge.Badge(badge.Props{Variant: questionStatusVariant(q.Status)}) { { questionStatusLabel(q.Status) } }
		}
		@table.Cell(table.CellProps{Class: "text-right text-muted-foreground"}) {
			@iconChevronRight("inline h-4 w-4")
		}
	}
}

templ InquiryEditPanel(q store.Question) {
	@adminPanelShell("Edit inquiry") {
		<form
			hx-post={ fmt.Sprintf("/admin/inquiries/%d", q.ID) }
			hx-target={ "#" + rowID("inquiry", q.ID) }
			hx-swap="outerHTML"
			hx-disabled-elt="find button[type='submit']"
			class="flex flex-1 flex-col gap-5 overflow-y-auto px-6 py-5"
		>
			<div class="space-y-1.5 text-sm">
				<h3 class="font-display text-base text-foreground">{ q.Name }</h3>
				@adminDetail("Contact", q.Contact)
				@adminDetail("Topic", q.Topic)
				@adminDetail("Received", humanDateTime(q.CreatedAt))
				<p class="mt-3 whitespace-pre-line rounded-lg bg-muted p-3 text-foreground">{ q.Message }</p>
			</div>
			<label class="block">
				<span class="mb-1.5 block text-sm font-medium text-foreground">Status</span>
				@selectbox.Select(selectbox.Props{Name: "status", Attrs: templ.Attributes{"data-autofocus": "true"}}) {
					for _, s := range questionStatusOrder {
						<option value={ s } selected?={ s == q.Status }>{ questionStatusLabel(s) }</option>
					}
				}
			</label>
			<label class="block">
				<span class="mb-1.5 block text-sm font-medium text-foreground">Private notes</span>
				@textarea.Textarea(textarea.Props{Name: "admin_notes", Rows: 3, Value: q.AdminNotes, NonResizable: true})
			</label>
			@adminEditActions(nil)
		</form>
	}
}

