		@table.Cell(table.CellProps{}) {
			@badge.Badge(badge.Props{Variant: waitlistStatusVariant(e.Status)}) { { waitlistStatusLabel(e.Status) } }
		}
		@table.Cell(table.CellProps{Class: "text-right text-muted-foreground"}) {
			@iconChevronRight("inline h-4 w-4")
		}
	}
}

