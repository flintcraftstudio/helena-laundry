templ AdminInquiriesPage(userEmail, status string, inquiries []store.Question) {
	@AdminBase("Inquiries", userEmail, "inquiries", adminSectionIntro("Contact inquiries", "Questions and feedback sent from the site.", InquiriesSection(status, inquiries)))
}

templ InquiriesSection(status string, inquiries []store.Question) {
	<section id="inquiries-section">
		@adminFilterTabs("inquiries-section", "/admin/inquiries", status, questionStatusOrder, questionStatusLabel)
		<div class="mt-4">
			@card.Card(card.Props{}) {
				@card.Body(card.SubProps{}) {
					if len(inquiries) == 0 {
						@adminEmpty("No inquiries here yet.")
					} else {
						@table.Table(table.Props{}) {
							@table.Head(table.HeadProps{}) {
								<tr>
									@table.Header(table.HeaderProps{}) { From }
									@table.Header(table.HeaderProps{}) { Topic }
									@table.Header(table.HeaderProps{}) { Message }
									@table.Header(table.HeaderProps{}) { Received }
									@table.Header(table.HeaderProps{}) { Status }
									@table.Header(table.HeaderProps{Class: "text-right"}) { Manage }
								</tr>
							}
							@table.Body(table.BodyProps{}) {
								for _, q := range inquiries {
									@InquirySummaryRow(q)
								}
							}
						}
					}
				}
			}
		</div>
	</section>
}

templ InquirySummaryRow(q store.Question) {
	@table.Row(table.RowProps{Attrs: templ.Attributes{"id": rowID("inquiry", q.ID)}}) {
		@table.Cell(table.CellProps{}) {
			<div class="font-medium text-foreground">{ q.Name }</div>
			<div class="text-xs text-muted-foreground">{ q.Contact }</div>
		}
		@table.Cell(table.CellProps{Class: "text-muted-foreground"}) { { q.Topic } }
		@table.Cell(table.CellProps{Class: "max-w-xs truncate text-muted-foreground"}) { { truncate(q.Message, 60) } }
		@table.Cell(table.CellProps{Class: "text-muted-foreground"}) { { humanDate(q.CreatedAt) } }
		@table.Cell(table.CellProps{}) {
			@badge.Badge(badge.Props{Variant: questionStatusVariant(q.Status)}) { { questionStatusLabel(q.Status) } }
		}
		@table.Cell(table.CellProps{Class: "text-right"}) {
			@button.Button(button.Props{Plain: true, Attrs: editAttrs("/admin/inquiries", "inquiry", q.ID)}) { Manage }
		}
	}
}

templ InquiryEditRow(q store.Question) {
	<tr id={ rowID("inquiry", q.ID) } class="bg-muted/40">
		<td colspan="6" class="px-4 py-5 sm:px-6">
			<form
				hx-post={ fmt.Sprintf("/admin/inquiries/%d", q.ID) }
				hx-target={ "#" + rowID("inquiry", q.ID) }
				hx-swap="outerHTML"
				class="grid gap-6 md:grid-cols-2"
			>
				<div class="space-y-1.5 text-sm">
					<h3 class="font-display text-base text-foreground">{ q.Name }</h3>
					@adminDetail("Contact", q.Contact)
					@adminDetail("Topic", q.Topic)
					@adminDetail("Received", humanDateTime(q.CreatedAt))
					<p class="mt-3 whitespace-pre-line rounded-lg bg-surface p-3 text-foreground">{ q.Message }</p>
				</div>
				<div class="space-y-4">
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium text-foreground">Status</span>
						@selectbox.Select(selectbox.Props{Name: "status"}) {
							for _, s := range questionStatusOrder {
								<option value={ s } selected?={ s == q.Status }>{ questionStatusLabel(s) }</option>
							}
						}
					</label>
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium text-foreground">Private notes</span>
						@textarea.Textarea(textarea.Props{Name: "admin_notes", Rows: 3, Value: q.AdminNotes, NonResizable: true})
					</label>
					@adminEditActions("/admin/inquiries", "inquiry", q.ID)
				</div>
			</form>
		</td>
	</tr>
}

