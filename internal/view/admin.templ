// ===========================================================================
// Shared admin bits
// ===========================================================================

// adminSectionIntro wraps a section with a page heading + lead line.
templ adminSectionIntro(title, lead string, section templ.Component) {
	<div class="mb-6">
		<h2 class="font-display text-2xl text-foreground">{ title }</h2>
		<p class="mt-1 text-sm text-muted-foreground">{ lead }</p>
	</div>
	@section
}

// adminFilterTabs is a flint-ui ModeServer tab row that swaps the section via htmx.
// extra is an optional query suffix carried on every tab (e.g. "q=foo" so a
// search survives a status switch); indicator is an optional hx-indicator
// selector. Pass "" for both on sections without search/indicator.
templ adminFilterTabs(sectionID, basePath, active string, order []string, label func(string) string, extra, indicator string) {
	@tabs.Tabs(tabs.Props{Mode: tabs.ModeServer, Active: statusKeyOrAll(active)}) {
		@tabs.List(tabs.ListProps{Mode: tabs.ModeServer}) {
			@adminFilterTab(sectionID, basePath, "all", "All", active, extra, indicator)
			for _, s := range order {
				@adminFilterTab(sectionID, basePath, s, label(s), active, extra, indicator)
			}
		}
	}
}

templ adminFilterTab(sectionID, basePath, name, label, active, extra, indicator string) {
	@tabs.Tab(tabs.TabProps{
		Name:   name,
		Mode:   tabs.ModeServer,
		Active: statusKeyOrAll(active),
		Attrs:  tabAttrs(sectionID, basePath, name, extra, indicator),
	}) {
		{ label }
	}
}

// tabAttrs builds the htmx attributes for one filter tab.
func tabAttrs(sectionID, basePath, name, extra, indicator string) templ.Attributes {
	a := templ.Attributes{
		"hx-get":      tabURL(basePath, name, extra),
		"hx-target":   "#" + sectionID,
		"hx-swap":     "outerHTML",
		"hx-push-url": "true",
	}
	if indicator != "" {
		a["hx-indicator"] = indicator
	}
	return a
}

// adminDetail is a label/value line in an edit panel.
templ adminDetail(label, value string) {
	<div class="flex gap-2">
		<span class="w-28 shrink-0 text-muted-foreground">{ label }</span>
		<span class="text-foreground">{ value }</span>
	</div>
}

// adminEditActions is the Save / Cancel pair shared by every edit form. path is
// the resource collection URL (e.g. "/admin/bookings"); kind is the row-id prefix.
// adminEditActions is the Save / Cancel pair shared by the edit drawers. Save
// submits the form (saveAttrs lets a form add e.g. a conditional hx-confirm);
// Cancel just slides the drawer shut.
templ adminEditActions(saveAttrs templ.Attributes) {
	<div class="flex items-center gap-3 pt-1">
		@button.Button(button.Props{Variant: button.VariantAccent, Type: "submit", Attrs: saveAttrs}) {
			Save
			@iconSpinner("form-spinner ml-1 h-4 w-4 animate-spin")
		}
		@button.Button(button.Props{Plain: true, Type: "button", Attrs: templ.Attributes{
			"@click": "$store.drawer.open = false",
		}}) {
			Cancel
		}
	</div>
}

// adminPanelShell is the drawer header (title + close) above an edit form.
templ adminPanelShell(title string) {
	<div class="flex items-center justify-between border-b border-border px-6 py-4">
		<h2 class="font-display text-lg text-foreground">{ title }</h2>
		<button
			type="button"
			@click="$store.drawer.open = false"
			aria-label="Close"
			class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground transition hover:bg-muted hover:text-foreground"
		>
			<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
		</button>
	</div>
	{ children... }
}

templ adminEmpty(msg string) {
	<div class="px-6 py-12 text-center text-sm text-muted-foreground">{ msg }</div>
}

// ---------------------------------------------------------------------------
// Small Go helpers for the admin views.
// ---------------------------------------------------------------------------

// rowID is the stable DOM id for a resource row (e.g. "booking-row-42").
func rowID(kind string, id int64) string {
	return fmt.Sprintf("%s-row-%d", kind, id)
}

// rowClickClass styles a summary row as a clickable control.
const rowClickClass = "cursor-pointer transition hover:bg-muted/60 focus:outline-none focus-visible:bg-muted/60"

// rowEditAttrs makes a summary <tr> the click / Enter target that swaps it for
// its edit form (flint-ui's htmx-on-row pattern — no separate action button).
// path is the resource collection URL; kind is the row-id prefix; label is the
// row's accessible name.
func rowEditAttrs(path, kind string, id int64, label string) templ.Attributes {
	return templ.Attributes{
		"id":         rowID(kind, id),
		"hx-get":     fmt.Sprintf("%s/%d/edit", path, id),
		"hx-target":  "#admin-drawer-body",
		"hx-swap":    "innerHTML",
		"hx-trigger": "click, keyup[key=='Enter']",
		"tabindex":   "0",
		"role":       "button",
		"aria-label": label,
	}
}

// tabURL builds a filter tab's hx-get URL. "all" drops the status; extra is an
// optional already-escaped query suffix (e.g. "q=foo").
func tabURL(basePath, name, extra string) string {
	switch {
	case name == "all" && extra == "":
		return basePath
	case name == "all":
		return basePath + "?" + extra
	case extra == "":
		return basePath + "?status=" + name
	default:
		return basePath + "?status=" + name + "&" + extra
	}
}

// statusKeyOrAll maps the empty status to the "all" tab key.
func statusKeyOrAll(status string) string {
	if status == "" {
		return "all"
	}
	return status
}

// planShort is the compact plan label used in dense admin tables.
func planShort(plan string) string {
	switch plan {
	case "standard":
		return "Wash & fold"
	case "weekly":
		return "Weekly"
	case "rush":
		return "Rush"
	default:
		return plan
	}
}
