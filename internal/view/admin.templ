					<label class="block">
						<span class="mb-1.5 block text-sm font-medium text-foreground">Private notes</span>
						@textarea.Textarea(textarea.Props{Name: "admin_notes", Rows: 3, Value: e.AdminNotes, NonResizable: true})
					</label>
					@adminEditActions("/admin/waitlist", "waitlist", e.ID)
				</div>
			</form>
		</td>
	</tr>
