package view

templ ContactPage(qErrors, qValues map[string]string, qSuccess bool, wErrors, wValues map[string]string, wSuccess bool) {
	@Base(
		"Contact & schedule a pickup",
		"Ready for a pickup? Call or text 406-471-8508 — no app to download, no account to make. Or send a note with a question, or join the out-of-area waitlist.",
		contactContent(qErrors, qValues, qSuccess, wErrors, wValues, wSuccess),
	)
}

templ contactContent(qErrors, qValues map[string]string, qSuccess bool, wErrors, wValues map[string]string, wSuccess bool) {
	<!-- Header -->
	<section class="bg-hl-cream">
		<div class="mx-auto max-w-content px-5 pt-16 pb-8 sm:px-8 sm:pt-20">
			<div class="max-w-2xl">
				@eyebrow("Contact & schedule")
				<h1 class="font-display text-[clamp(2.4rem,5vw,3.7rem)] leading-[1.05] text-hl-brown">Ready for a pickup? Let's go.</h1>
			</div>
		</div>
	</section>

	<!-- Schedule a pickup (primary path) -->
	<section class="bg-hl-cream">
		<div class="mx-auto max-w-content px-5 pb-12 sm:px-8">
			<div class="overflow-hidden rounded-2xl bg-hl-rust-deep text-hl-cream shadow-hl-md">
				<div class="grid gap-8 p-8 sm:p-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
					<div>
						<p class="text-[13px] font-bold uppercase tracking-caps text-hl-ochre">Schedule a pickup</p>
						<h2 class="mt-3 font-display text-[clamp(1.8rem,3.4vw,2.5rem)] leading-tight text-hl-cream">Book a pickup in under a minute.</h2>
						<p class="mt-4 max-w-lg text-[17px] leading-relaxed text-hl-cream">
							Tell me your name, when you'd like your laundry picked up, and how you want it done — that's it. No app to download, no account to make. Rather just call or text? That works too.
						</p>
						<p class="mt-5 text-[14px] text-hl-cream">
							I pick up across the Helena Valley. Most orders are back on your porch in 24 to 48 hours.
						</p>
					</div>
					<div class="flex flex-col gap-3 lg:items-end">
						@btnBookLight("Book a pickup")
						<a
							href={ templ.SafeURL(PhoneTel) }
							class="inline-flex items-center justify-center gap-2.5 rounded-pill border-[1.5px] border-hl-cream/60 px-7 py-3 text-[15px] font-semibold text-hl-cream transition hover:bg-hl-cream/10"
						>
							@iconPhone("h-[18px] w-[18px]")
							Call or text { Phone }
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Two forms -->
	<section class="bg-hl-cream">
		<div class="mx-auto grid max-w-content gap-6 px-5 pb-20 sm:px-8 lg:grid-cols-2 lg:gap-7">
			<!-- Question / feedback -->
			<div class="rounded-2xl border border-hl-brown/10 bg-hl-white p-8 shadow-hl-sm">
				<div class="mb-6">
					<span class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-hl-teal/10 text-hl-teal-deep">
						@iconMessage("h-6 w-6")
					</span>
					<h2 class="font-display text-[26px] leading-tight text-hl-brown">Got a question first?</h2>
					<p class="mt-2 text-[15px] leading-relaxed text-hl-brown-soft">
						Not ready to schedule, or just want to ask something? Send me a note and I'll get back to you within a day.
					</p>
				</div>
				@QuestionForm(qErrors, qValues, qSuccess)
			</div>

			<!-- Waitlist -->
			<div id="waitlist" class="scroll-mt-24 rounded-2xl border border-hl-rust/25 bg-hl-tint p-8 shadow-hl-sm">
				<div class="mb-6">
					<span class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-hl-rust/10 text-hl-rust">
						@iconMapPin("h-6 w-6")
					</span>
					<h2 class="font-display text-[26px] leading-tight text-hl-brown">Not in the Helena Valley yet?</h2>
					<p class="mt-2 text-[15px] leading-relaxed text-hl-brown-soft">
						Right now I run pickups across the Helena Valley — that's as far as one person can stretch and still do it right. But I'd rather grow on purpose than guess. Put your name down, and when enough folks in one direction raise their hands, that's where I head next.
					</p>
				</div>
				@WaitlistForm(wErrors, wValues, wSuccess)
			</div>
		</div>
	</section>
}

// ---------------------------------------------------------------------------
// Question / feedback form
// ---------------------------------------------------------------------------

templ QuestionForm(errors, values map[string]string, success bool) {
	if success {
		@formConfirmation("teal") {
			Got it — thanks for writing. I'll get back to you within a day. Need a pickup sooner than that? Just call or text me at { Phone }.
		}
	} else {
		<form hx-post="/contact/question" hx-swap="outerHTML" class="space-y-4">
			@formErrorSummary(errors)
			@fieldText("q-name", "name", "Your name", "Jane Doe", values["name"], errors["name"], true)
			@fieldText("q-contact", "contact", "Best way to reach you", "Phone or email", values["contact"], errors["contact"], true)
			@fieldSelect("q-topic", "topic", "What's on your mind?", values["topic"], errors["topic"], []selectOption{
				{"question", "A question"},
				{"feedback", "Feedback"},
				{"schedule", "I want to schedule"},
			})
			<!-- If they pick "I want to schedule," nudge them to the faster booking modal. -->
			<div
				x-data="{ t: '' }"
				x-init="let s = $el.previousElementSibling.querySelector('select'); t = s.value; s.addEventListener('change', e => t = e.target.value)"
				x-show="t === 'schedule'"
				x-cloak
				class="rounded-xl border border-hl-rust/25 bg-hl-rust/[0.05] p-3.5"
			>
				<button type="button" @click="$store.booking.open()" class="group inline-flex items-center gap-1.5 text-[14px] font-semibold text-hl-rust-deep">
					Ready to book? Skip the form and book a pickup
					@iconArrowRight("h-4 w-4 transition-transform duration-200 ease-hl-out group-hover:translate-x-0.5")
				</button>
			</div>
			@fieldTextarea("q-message", "message", "Your message", "Ask away…", values["message"], errors["message"], true)
			if TurnstileSiteKey != "" {
				<div class="cf-turnstile" data-sitekey={ TurnstileSiteKey }></div>
			}
			<p class="text-[12px] text-hl-brown-soft"><span class="text-hl-rust" aria-hidden="true">*</span> Required</p>
			@submitButton("Send it over")
		</form>
	}
}

// ---------------------------------------------------------------------------
// Out-of-area waitlist form
// ---------------------------------------------------------------------------

templ WaitlistForm(errors, values map[string]string, success bool) {
	if success {
		@formConfirmation("rust") {
			You're on the list. I keep an eye on where folks are signing up from, and when one area's got enough interest to do right by, that's where I expand. I'll reach out when I'm headed your way. Thanks for raising your hand. <span class="font-medium">— Chanté</span>
		}
	} else {
		<form hx-post="/contact/waitlist" hx-swap="outerHTML" class="space-y-4">
			@formErrorSummary(errors)
			@fieldText("w-name", "name", "Name", "Jane Doe", values["name"], errors["name"], true)
			@fieldText("w-location", "location", "Where you are", "Town or neighborhood — East Helena, Townsend, Boulder…", values["location"], errors["location"], true)
			@fieldText("w-contact", "contact", "Best way to reach you", "Phone or email", values["contact"], errors["contact"], true)
			@fieldKind(values["kind"])
			@fieldTextareaOptional("w-notes", "notes", "Anything I should know?", "Optional", values["notes"])
			if TurnstileSiteKey != "" {
				<div class="cf-turnstile" data-sitekey={ TurnstileSiteKey }></div>
			}
			<p class="text-[12px] text-hl-brown-soft"><span class="text-hl-rust" aria-hidden="true">*</span> Required</p>
			@submitButton("Add me to the list")
		</form>
	}
}

// ---------------------------------------------------------------------------
// Form field primitives (warm light theme)
// ---------------------------------------------------------------------------

type selectOption struct {
	Value string
	Label string
}

templ fieldText(id, name, label, placeholder, value, err string, required bool) {
	<div>
		<label for={ id } class="mb-1.5 block text-[14px] font-semibold text-hl-brown">
			{ label }
			if required {
				<span class="text-hl-rust" aria-hidden="true">*</span>
			}
		</label>
		<input
			type="text"
			id={ id }
			name={ name }
			value={ value }
			placeholder={ placeholder }
			required?={ required }
			if err != "" {
				aria-invalid="true"
				aria-describedby={ id + "-err" }
			}
			class={ "hl-input", templ.KV("border-hl-rust/70", err != "") }
		/>
		if err != "" {
			@fieldErr(id + "-err", err)
		}
	</div>
}

templ fieldTextarea(id, name, label, placeholder, value, err string, required bool) {
	<div>
		<label for={ id } class="mb-1.5 block text-[14px] font-semibold text-hl-brown">
			{ label }
			if required {
				<span class="text-hl-rust" aria-hidden="true">*</span>
			}
		</label>
		<textarea
			id={ id }
			name={ name }
			rows="4"
			placeholder={ placeholder }
			required?={ required }
			if err != "" {
				aria-invalid="true"
				aria-describedby={ id + "-err" }
			}
			class={ "hl-input", templ.KV("border-hl-rust/70", err != "") }
		>{ value }</textarea>
		if err != "" {
			@fieldErr(id + "-err", err)
		}
	</div>
}

templ fieldTextareaOptional(id, name, label, placeholder, value string) {
	<div>
		<label for={ id } class="mb-1.5 block text-[14px] font-semibold text-hl-brown">{ label } <span class="font-normal text-hl-brown-faint">(optional)</span></label>
		<textarea
			id={ id }
			name={ name }
			rows="3"
			placeholder={ placeholder }
			class="w-full rounded-xl border border-hl-brown/20 bg-hl-white px-4 py-3 text-[16px] text-hl-brown placeholder-hl-brown-faint outline-none transition focus:border-hl-rust"
		>{ value }</textarea>
	</div>
}

templ fieldSelect(id, name, label, value, err string, options []selectOption) {
	<div>
		<label for={ id } class="mb-1.5 block text-[14px] font-semibold text-hl-brown">{ label }</label>
		<select
			id={ id }
			name={ name }
			if err != "" {
				aria-invalid="true"
				aria-describedby={ id + "-err" }
			}
			class={ "w-full appearance-none rounded-xl border bg-hl-white bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%236B5848%22 stroke-width=%221.75%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><path d=%22m6 9 6 6 6-6%22/></svg>')] bg-[length:20px] bg-[right_0.85rem_center] bg-no-repeat px-4 py-3 pr-11 text-[16px] text-hl-brown outline-none transition focus:border-hl-rust", templ.KV("border-hl-rust/70", err != ""), templ.KV("border-hl-brown/20", err == "") }
		>
			for _, opt := range options {
				<option value={ opt.Value } selected?={ value == opt.Value }>{ opt.Label }</option>
			}
		</select>
		if err != "" {
			@fieldErr(id + "-err", err)
		}
	</div>
}

// fieldKind is the residential/business radio pair for the waitlist.
templ fieldKind(value string) {
	<fieldset>
		<legend class="mb-1.5 block text-[14px] font-semibold text-hl-brown">Is this for a home or a business?</legend>
		<div class="grid grid-cols-2 gap-3">
			@kindOption("residential", "A home", value == "" || value == "residential")
			@kindOption("business", "A business", value == "business")
		</div>
	</fieldset>
}

templ kindOption(val, label string, checked bool) {
	<label class="cursor-pointer">
		<input type="radio" name="kind" value={ val } checked?={ checked } class="peer sr-only"/>
		<span class="flex items-center justify-center rounded-xl border border-hl-brown/20 bg-hl-white px-4 py-3 text-[15px] font-medium text-hl-brown-soft transition peer-checked:border-hl-rust peer-checked:bg-hl-rust/[0.06] peer-checked:text-hl-rust peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-hl-rust">{ label }</span>
	</label>
}

templ fieldErr(id, err string) {
	<p id={ id } class="mt-1 text-[13px] text-hl-rust">{ err }</p>
}

// formError is a single form-level error banner (used by the login form). Like
// formErrorSummary it is focusable + role="alert" so the layout's afterSwap
// script moves focus here and screen readers announce it.
templ formError(msg string) {
	<div data-formstatus tabindex="-1" role="alert" class="rounded-xl border border-hl-rust/40 bg-hl-rust/[0.07] p-4 outline-none">
		<p class="text-[14px] text-hl-rust-deep">{ msg }</p>
	</div>
}

// formErrorSummary is the focusable, announced banner shown at the top of a form
// after a failed submit. role="alert" announces it; tabindex -1 lets the
// afterSwap script move focus here so keyboard/SR users land on the problem.
templ formErrorSummary(errors map[string]string) {
	if len(errors) > 0 {
		<div data-formstatus tabindex="-1" role="alert" class="rounded-xl border border-hl-rust/40 bg-hl-rust/[0.07] p-4 outline-none">
			if errors["form"] != "" {
				<p class="text-[14px] text-hl-rust-deep">{ errors["form"] }</p>
			} else {
				<p class="text-[14px] text-hl-rust-deep">A few fields need a quick fix — see the notes below.</p>
			}
		</div>
	}
}

templ submitButton(label string) {
	<button
		type="submit"
		hx-disabled-elt="this"
		class="inline-flex w-full items-center justify-center gap-2 rounded-pill bg-hl-rust px-7 py-3.5 text-[16px] font-semibold text-hl-cream shadow-[0_4px_14px_rgba(192,73,43,0.18)] transition duration-200 ease-hl-out hover:bg-hl-rust-deep hover:shadow-hl-rust active:scale-[0.98] disabled:cursor-wait disabled:opacity-80 sm:w-auto"
	>
		{ label }
		@iconArrowRight("h-[18px] w-[18px]")
		@iconSpinner("form-spinner h-[18px] w-[18px] animate-spin")
	</button>
}

templ formConfirmation(tone string) {
	<div data-formstatus tabindex="-1" role="status" class={ "flex items-start gap-4 rounded-2xl border p-6 outline-none", templ.KV("border-hl-teal/30 bg-hl-teal/[0.07]", tone == "teal"), templ.KV("border-hl-rust/30 bg-hl-rust/[0.07]", tone == "rust") }>
		<span class={ "mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full", templ.KV("bg-hl-teal/15 text-hl-teal-deep", tone == "teal"), templ.KV("bg-hl-rust/15 text-hl-rust", tone == "rust") }>
			@iconCheck("h-5 w-5")
		</span>
		<p class="text-[16px] leading-relaxed text-hl-brown">
			{ children... }
		</p>
	</div>
}
