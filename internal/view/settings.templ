package view

import (
	"strings"

	"github.com/firefly-software-mt/advanced-template/internal/store"

	"github.com/flintcraftstudio/flint-ui/components/button"
	"github.com/flintcraftstudio/flint-ui/components/card"
	"github.com/flintcraftstudio/flint-ui/components/input"
	"github.com/flintcraftstudio/flint-ui/components/textarea"
)

// settingsWeekdays are the day options for the pickup-days picker.
var settingsWeekdays = []string{"Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"}

templ AdminSettingsPage(userEmail string, s store.Settings) {
	@AdminBase("Settings", userEmail, "settings", adminSectionIntro("Site settings", "What the public site says and who you pick up for. Saved changes take effect right away.", SettingsRegion(s)))
}

// SettingsRegion is the htmx swap target — the whole form re-renders on save.
templ SettingsRegion(s store.Settings) {
	<div id="settings-region">
		<form hx-post="/admin/settings" hx-target="#settings-region" hx-swap="outerHTML" class="space-y-6">
			@settingsCard("Business identity", "Shown across the public site — nav, footer, contact.") {
				<div class="grid gap-4 sm:grid-cols-2">
					@settingsField("Business name", "site_name", s.SiteName)
					@settingsField("Phone (call/text)", "phone", s.Phone)
					@settingsField("Email", "email", s.Email)
					@settingsField("Hours", "hours", s.Hours)
					@settingsField("Turnaround", "turnaround", s.Turnaround)
				</div>
				@settingsFieldWide("Tagline", "tagline", s.Tagline)
			}
			@settingsCard("Service area & availability", "Where you pick up, which days, and whether you're taking new bookings.") {
				<label class="flex items-center gap-3">
					<input type="checkbox" name="accepting_bookings" value="1" checked?={ s.AcceptingBookings } class="h-5 w-5 accent-accent"/>
					<span class="text-sm font-medium text-foreground">Accepting new bookings</span>
					<span class="text-xs text-muted-foreground">Turn off to pause the booking form and decline new pickups.</span>
				</label>
				<div>
					<span class="mb-1.5 block text-sm font-medium text-foreground">Pickup ZIP codes</span>
					@textarea.Textarea(textarea.Props{Name: "allowed_zips", Rows: 2, Value: strings.Join(s.AllowedZips, ", "), Placeholder: "59601, 59602, …"})
					<p class="mt-1 text-xs text-muted-foreground">Comma- or space-separated. Bookings outside these go to the waitlist.</p>
				</div>
				<div>
					<span class="mb-1.5 block text-sm font-medium text-foreground">Pickup days</span>
					<div class="flex flex-wrap gap-2">
						for _, d := range settingsWeekdays {
							<label class="cursor-pointer">
								<input type="checkbox" name="pickup_days" value={ d } checked?={ daySelected(s.PickupDays, d) } class="peer sr-only"/>
								<span class="inline-flex rounded-pill border border-border px-3.5 py-1.5 text-sm font-medium text-muted-foreground transition peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent">{ d }</span>
							</label>
						}
					</div>
				</div>
			}
			@settingsCard("Pricing", "Drives the booking form and the pickup email. (The marketing pages stay hand-written.)") {
				<div class="grid gap-4 sm:grid-cols-3">
					@settingsField("Per-pound rate ($)", "lb_rate", s.LbRate)
					@settingsField("Rush rate ($)", "rush_rate", s.RushRate)
					@settingsField("Minimum order ($)", "minimum_order", s.MinimumOrder)
				</div>
				<div class="space-y-2">
					<span class="block text-sm font-medium text-foreground">Flat rates</span>
					<div class="grid grid-cols-[1fr_7rem] gap-2 text-xs font-medium text-muted-foreground">
						<span>Item</span>
						<span>Price ($)</span>
					</div>
					for _, fr := range s.FlatRates {
						@settingsFlatRow(fr.Label, fr.Price)
					}
					@settingsFlatRow("", "")
					@settingsFlatRow("", "")
					<p class="text-xs text-muted-foreground">Clear an item's name to remove it. Blank rows are ignored.</p>
				</div>
			}
			<div class="flex items-center gap-3">
				@button.Button(button.Props{Variant: button.VariantAccent, Type: "submit"}) { Save settings }
				<span class="text-xs text-muted-foreground">Changes apply to the live site immediately.</span>
			</div>
		</form>
	</div>
}

templ settingsCard(title, lead string) {
	@card.Card(card.Props{}) {
		@card.Header(card.SubProps{}) {
			<h3 class="font-display text-lg text-foreground">{ title }</h3>
			<p class="mt-0.5 text-sm text-muted-foreground">{ lead }</p>
		}
		@card.Body(card.SubProps{Class: "space-y-4"}) {
			{ children... }
		}
	}
}

templ settingsField(label, name, value string) {
	<label class="block">
		<span class="mb-1.5 block text-sm font-medium text-foreground">{ label }</span>
		@input.Input(input.Props{Name: name, Value: value})
	</label>
}

templ settingsFieldWide(label, name, value string) {
	<label class="block">
		<span class="mb-1.5 block text-sm font-medium text-foreground">{ label }</span>
		@input.Input(input.Props{Name: name, Value: value})
	</label>
}

templ settingsFlatRow(label, price string) {
	<div class="grid grid-cols-[1fr_7rem] gap-2">
		@input.Input(input.Props{Name: "flat_label", Value: label, Placeholder: "e.g. Queen bedding"})
		@input.Input(input.Props{Name: "flat_price", Value: price, Placeholder: "30"})
	</div>
}

// daySelected reports whether d is in the selected pickup days.
func daySelected(days []string, d string) bool {
	for _, x := range days {
		if x == d {
			return true
		}
	}
	return false
}
