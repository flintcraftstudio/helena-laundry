package view

// ----------------------------------------------------------------------------
// Shared brand components — eyebrows, buttons, rules.
// ----------------------------------------------------------------------------

// eyebrow renders the small-caps tracked label used above section headings.
templ eyebrow(label string) {
	<p class="eyebrow mb-4">{ label }</p>
}

// doubleRule renders the twin border-rule that echoes the badge's double ring.
templ doubleRule() {
	<div class="rule-double w-16" role="presentation"></div>
}

// btnCall is the primary CTA used everywhere: call or text Chanté.
// label lets each placement phrase it in context.
templ btnCall(label string) {
	<a
		href={ templ.SafeURL(PhoneTel) }
		class="group inline-flex items-center gap-2.5 rounded-pill bg-hl-rust px-7 py-3.5 font-body text-base font-semibold text-hl-white shadow-[0_4px_14px_rgba(192,73,43,0.18)] transition duration-200 ease-hl-out hover:bg-hl-rust-deep hover:shadow-hl-rust active:scale-[0.97]"
	>
		@iconPhone("h-[18px] w-[18px]")
		{ label }
	</a>
}

// btnGhost is the secondary outline CTA (rust ring, transparent fill).
// rust-deep clears AA for the label text on cream/tint backgrounds.
templ btnGhost(href, label string) {
	<a
		href={ templ.SafeURL(href) }
		class="inline-flex items-center gap-2 rounded-pill border-[1.5px] border-hl-rust-deep px-7 py-3.5 font-body text-base font-semibold text-hl-rust-deep transition duration-200 ease-hl-out hover:bg-hl-rust-deep/[0.06] active:scale-[0.97]"
	>
		{ label }
	</a>
}

// btnGhostIcon is btnGhost with a leading message icon (for "Send a note" CTAs).
templ btnGhostIcon(href, label string) {
	<a
		href={ templ.SafeURL(href) }
		class="inline-flex items-center gap-2.5 rounded-pill border-[1.5px] border-hl-rust-deep px-7 py-3.5 font-body text-base font-semibold text-hl-rust-deep transition duration-200 ease-hl-out hover:bg-hl-rust-deep/[0.06] active:scale-[0.97]"
	>
		@iconMessage("h-[18px] w-[18px]")
		{ label }
	</a>
}

// textLink is an inline link with a trailing arrow — the demoted secondary CTA.
// rust-deep clears AA on light backgrounds.
templ textLink(href, label string) {
	<a href={ templ.SafeURL(href) } class="group inline-flex items-center gap-1.5 font-semibold text-hl-rust-deep underline decoration-hl-rust-deep/40 underline-offset-4 transition hover:decoration-hl-rust-deep">
		{ label }
		@iconArrowRight("h-4 w-4 transition-transform duration-200 ease-hl-out group-hover:translate-x-0.5")
	</a>
}

// ----------------------------------------------------------------------------
// Inline SVG icons (Lucide paths, 1.75px round stroke). No JS / CDN dependency.
// Pass Tailwind sizing/colour via the class argument.
// ----------------------------------------------------------------------------

templ iconBase(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		{ children... }
	</svg>
}

templ iconPhone(class string) {
	@iconBase(class) {
		<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path>
	}
}

templ iconMessage(class string) {
	@iconBase(class) {
		<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"></path>
	}
}

templ iconArrowRight(class string) {
	@iconBase(class) {
		<path d="M5 12h14"></path>
		<path d="m12 5 7 7-7 7"></path>
	}
}

templ iconCheck(class string) {
	@iconBase(class) {
		<path d="M20 6 9 17l-5-5"></path>
	}
}

// Step / feature icons
templ iconBag(class string) {
	@iconBase(class) {
		<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
		<path d="M3 6h18"></path>
		<path d="M16 10a4 4 0 0 1-8 0"></path>
	}
}

