package view

templ BusinessesPage() {
	@Base(
		"For businesses",
		"Laundry your business can count on. Standing pickups, flat rates on bulk towels and linens, and one person who knows your order and gets it back on time. Salons, spas, rentals, gyms, clinics.",
		businessesContent(),
	)
}

templ businessesContent() {
	<!-- ============ Hero ============ -->
	<section class="bg-hl-cream">
		<div class="mx-auto max-w-content px-5 pt-16 pb-12 sm:px-8 sm:pt-24 sm:pb-16">
			<div class="max-w-3xl">
				@eyebrow("For businesses")
				<h1 class="font-display text-display-xl text-hl-brown">Laundry your business can count on.</h1>
				<p class="mt-6 max-w-2xl text-lg text-hl-brown-soft">
					If your week runs on clean towels and linens, you already know what it costs you when they're not ready. I take that off your plate — picked up on a schedule you set, back when I said it'd be back.
				</p>
				<div class="mt-8">
					@btnCall("Call or text to talk it over")
				</div>
			</div>
		</div>
	</section>
	<!-- ============ Who this is for (editorial index, not a card grid) ============ -->
	<section class="border-y border-hl-brown/10 bg-hl-tint">
		<div class="mx-auto max-w-content px-5 py-16 sm:px-8 sm:py-20">
			<h2 class="max-w-2xl font-display text-display-lg text-hl-brown">Anybody with a standing pile and no time to deal with it.</h2>
			<div class="mt-12 grid gap-x-8 gap-y-9 sm:grid-cols-2 lg:grid-cols-4">
				@audienceItem("Salons & barbershops", "Going through towels by the armful.") {
					@iconScissors("h-7 w-7")
				}
				@audienceItem("Spas & massage therapists", "Sheets and wraps to turn over.") {
					@iconSparkle("h-7 w-7")
				}
				@audienceItem("Rentals & Airbnb hosts", "Flipping linens between guests.") {
					@iconHome("h-7 w-7")
				}
				@audienceItem("Gyms, studios & clinics", "Standing piles, every week.") {
					@iconDumbbell("h-7 w-7")
				}
			</div>
		</div>
	</section>
	<!-- ============ How it works for a business ============ -->
	<section class="bg-hl-cream">
		<div class="mx-auto max-w-content px-5 py-20 sm:px-8 sm:py-28">
			<div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
				<div>
					@eyebrow("How it works for a business")
					<h2 class="font-display text-display-lg text-hl-brown">Same as anyone else, just steadier.</h2>
				</div>
				<div class="space-y-5 text-lg text-hl-brown-soft">
					<p>
						We set a standing pickup day — or a couple a week if your volume needs it. I pick up, wash, dry, fold, and have it back on schedule. The bulky, high-volume stuff like towels and rags runs on flat rates, so your costs are predictable and there's nothing to puzzle over at month's end.
					</p>
					<div class="rounded-2xl border border-hl-rust/25 bg-hl-tint p-6 shadow-hl-sm">
						<div class="flex items-start gap-3.5">
							@iconHeart("h-6 w-6 shrink-0 text-hl-rust")
							<p class="text-base text-hl-brown">
								<span class="font-semibold">One person handles your account, every time.</span> I'll know your order, your preferences, and your turnaround — no rotating crew, no explaining it twice.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- ============ What it costs (teal band — the peak) ============ -->
	<section class="bg-hl-teal-deep text-hl-cream">
		<div class="mx-auto max-w-content px-5 py-24 sm:px-8 sm:py-32">
			<div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
				<div>
					<p class="text-[13px] font-bold uppercase tracking-caps text-hl-cream/90">What it costs</p>
					<h2 class="mt-4 font-display text-display-lg text-hl-cream">Predictable rates. No runaround.</h2>
					<p class="mt-5 text-lg text-hl-cream">
						A 13-gallon bag of towels, rags, or similar is $35. Linens and everything else run the same rates as my { "" }
						<a href="/services#pricing" class="font-semibold text-hl-white underline decoration-hl-ochre underline-offset-4 transition hover:decoration-hl-white">regular price list</a>
						{ "" } — and if you've got real volume, call me and we'll work out something that makes sense for both of us.
					</p>
				</div>
				<div class="rounded-2xl bg-black/10 p-7 ring-1 ring-hl-cream/15">
					<div class="flex items-baseline justify-between gap-4 border-b border-hl-cream/15 pb-4">
						<span class="text-base text-hl-cream">13-gallon bag of towels &amp; rags</span>
						<span class="shrink-0 font-display text-3xl text-hl-white">$35</span>
					</div>
					<div class="flex items-baseline justify-between gap-4 pt-4">
						<span class="text-base text-hl-cream">Linens &amp; everything else</span>
						<span class="shrink-0 text-sm text-hl-cream/90">Regular rates</span>
					</div>
					<p class="mt-5 text-sm text-hl-cream/90">
						Real volume? We'll work out a flat rate that makes sense for both of us.
					</p>
				</div>
			</div>
		</div>
	</section>
	<!-- ============ Let's talk it over (rust band close) ============ -->
	<section class="bg-hl-rust text-hl-white">
		<div class="mx-auto max-w-content px-5 py-20 text-center sm:px-8 sm:py-28">
			<h2 class="mx-auto max-w-2xl font-display text-display-xl text-hl-white">Let's talk it over.</h2>
			<p class="mx-auto mt-5 max-w-xl text-lg text-hl-white/95">
				Tell me what you go through in a week and I'll tell you exactly what it'll run and how fast you'll get it back. No runaround.
			</p>
			<div class="mt-9 flex flex-col items-center gap-4">
				<a
					href={ templ.SafeURL(PhoneTel) }
					class="inline-flex items-center gap-2.5 rounded-pill bg-hl-white px-7 py-3.5 text-base font-semibold text-hl-rust-deep transition duration-200 ease-hl-out hover:bg-hl-cream active:scale-[0.97]"
				>
					@iconPhone("h-[18px] w-[18px]")
					Call or text: { Phone }
				</a>
				<a
					href="/contact"
					class="group inline-flex items-center gap-1.5 text-base font-semibold text-hl-white underline decoration-hl-white/50 underline-offset-4 transition hover:decoration-hl-white"
				>
					Rather send a note first?
					@iconArrowRight("h-4 w-4 transition-transform duration-200 ease-hl-out group-hover:translate-x-0.5")
				</a>
			</div>
		</div>
	</section>
}

// audienceItem is one entry in the "who this is for" index — a top hairline,
// teal icon, label, and one line. Lighter than a boxed card so the four read as
// an editorial row, not a templated grid.
templ audienceItem(title, body string) {
	<div class="border-t border-hl-brown/15 pt-5">
		<span class="text-hl-teal-deep">
			{ children... }
		</span>
		<h3 class="mt-4 font-display text-xl leading-snug text-hl-brown">{ title }</h3>
		<p class="mt-1.5 text-sm text-hl-brown-soft">{ body }</p>
	</div>
}
